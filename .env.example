# Copy to .env and fill in for local development.
# In CML, these are set as project or Application environment variables
# instead (see .project-metadata.yaml and deploy/cml-deployment.md).

# Cloudera AI Inference Service endpoint (OpenAI-compatible), e.g.
#   https://<domain>/namespaces/serving-default/endpoints/<endpoint>/v1
# The model must support tool calling.
CAII_BASE_URL=
CAII_MODEL_NAME=meta/llama-3.1-70b-instruct
# Leave blank inside CML: the workload token at /tmp/jwt is used. Locally,
# set this or CDP_TOKEN.
CAII_API_KEY=
CDP_TOKEN=
LLM_TEMPERATURE=0.1

# auto = e2b when E2B_API_KEY is set, otherwise local (not isolated; synthetic data only)
SANDBOX_PROVIDER=auto
E2B_API_KEY=

# Seed for the synthetic network's counters
SIM_SEED=7
AUDIT_LOG_PATH=output/audit.jsonl
